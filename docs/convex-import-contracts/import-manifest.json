{
  "schemaVersion": 1,
  "name": "kinflo-convex-import-contracts",
  "externalWrites": false,
  "hostedDeploymentRequired": false,
  "blockedUntil": "Convex deployment, auth ownership, backup, and generated binding setup are approved.",
  "contracts": [
    {
      "id": "admin-preferences-from-admin-preferences",
      "phase": 3,
      "sourceTables": ["adminPreferences"],
      "targetCollection": "adminPreferences",
      "targetStatus": "implemented",
      "scope": "user/tenant/site",
      "operation": "upsert",
      "idempotencyKey": "admin-preference:source-table:adminPreferences:source-id",
      "requiredFields": ["userId", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Legacy admin UI, workflow, notification, and communication preferences become user-owned records with optional tenant/site scope attached during import mapping."
    },
    {
      "id": "assets-from-image-assets",
      "phase": 2,
      "sourceTables": ["imageAssets"],
      "targetCollection": "assets",
      "targetStatus": "implemented",
      "scope": "tenant/site",
      "operation": "upsert",
      "idempotencyKey": "asset:source-table:imageAssets:source-id",
      "requiredFields": ["tenantId", "name", "kind", "status", "storageProvider", "storageKey", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Binary files stay in object storage or Cloudinary-compatible storage; Convex stores metadata and provenance only."
    },
    {
      "id": "audit-events-from-audit-logs",
      "phase": 1,
      "sourceTables": ["auditLogs"],
      "targetCollection": "auditEvents",
      "targetStatus": "implemented",
      "scope": "platform/tenant/site",
      "operation": "append",
      "idempotencyKey": "audit:source-table:auditLogs:source-id",
      "requiredFields": ["scopeType", "action", "resourceType", "createdAt"],
      "externalWrites": false,
      "notes": "Normalize legacy action metadata into scoped audit events before live import."
    },
    {
      "id": "billing-plans-seeded-from-default-catalog",
      "phase": 5,
      "sourceTables": [],
      "targetCollection": "billingPlans",
      "targetStatus": "implemented",
      "scope": "platform",
      "operation": "seed-after-approval",
      "idempotencyKey": "billing-plan:key",
      "requiredFields": ["key", "label", "status", "limits", "features", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Seed the provider-light default plan catalog before Stripe price IDs are attached."
    },
    {
      "id": "content-blocks-from-content-items",
      "phase": 2,
      "sourceTables": ["contentItems"],
      "targetCollection": "contentBlocks",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "upsert",
      "idempotencyKey": "content-block:source-table:contentItems:source-id",
      "requiredFields": ["siteId", "pageId", "type", "order", "status", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Legacy content becomes block records attached to generated page records."
    },
    {
      "id": "content-visibility-rules-from-content-visibility",
      "phase": 2,
      "sourceTables": ["contentVisibility"],
      "targetCollection": "contentVisibilityRules",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "upsert",
      "idempotencyKey": "visibility-rule:source-table:contentVisibility:source-id",
      "requiredFields": ["siteId", "blockId", "isVisible", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Persona and journey-stage rules stay site-scoped."
    },
    {
      "id": "domains-seeded-after-site-verification",
      "phase": 2,
      "sourceTables": [],
      "targetCollection": "domains",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "seed-after-approval",
      "idempotencyKey": "domain:site-id:hostname",
      "requiredFields": ["tenantId", "siteId", "hostname", "status", "isPrimary", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Domain verification tokens are generated only after hosted deployment setup is approved."
    },
    {
      "id": "feature-flags-from-admin-entitlements",
      "phase": 1,
      "sourceTables": ["adminEntitlements"],
      "targetCollection": "featureFlags",
      "targetStatus": "implemented",
      "scope": "tenant/site",
      "operation": "upsert",
      "idempotencyKey": "feature-flag:source-table:adminEntitlements:source-id",
      "requiredFields": ["key", "enabled", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Manual pilot entitlements become tenant or site feature flags."
    },
    {
      "id": "invitations-seeded-from-pending-access",
      "phase": 1,
      "sourceTables": [],
      "targetCollection": "invitations",
      "targetStatus": "implemented",
      "scope": "tenant/site",
      "operation": "seed-after-approval",
      "idempotencyKey": "invitation:tenant-id:site-id:email-hash",
      "requiredFields": ["tenantId", "email", "role", "status", "invitedBy", "expiresAt", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Raw invite tokens and email delivery are outside the provider-light contract."
    },
    {
      "id": "lead-assignments-from-lead-assignments",
      "phase": 3,
      "sourceTables": ["leadAssignments"],
      "targetCollection": "leadAssignments",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "upsert",
      "idempotencyKey": "lead-assignment:source-table:leadAssignments:source-id",
      "requiredFields": ["tenantId", "siteId", "leadId", "assignedTo", "assignedBy", "assignmentType", "status", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Legacy assignments become site-scoped lead assignments after users and leads are mapped."
    },
    {
      "id": "lead-events-from-interactions-and-pipeline-history",
      "phase": 3,
      "sourceTables": ["interactions", "pipelineHistory"],
      "targetCollection": "leadEvents",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "append",
      "idempotencyKey": "lead-event:source-table:source-id",
      "requiredFields": ["tenantId", "siteId", "leadId", "type", "createdAt"],
      "externalWrites": false,
      "notes": "Interactions and pipeline changes become append-only lead timeline events."
    },
    {
      "id": "leads-from-leads",
      "phase": 3,
      "sourceTables": ["leads"],
      "targetCollection": "leads",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "upsert",
      "idempotencyKey": "lead:source-table:leads:source-id",
      "requiredFields": ["tenantId", "siteId", "email", "status", "pipelineStageKey", "engagementScore", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Legacy leads become site-scoped CRM records tied to a tenant and public site."
    },
    {
      "id": "memberships-from-users-and-organizations",
      "phase": 1,
      "sourceTables": ["users", "organizations"],
      "targetCollection": "memberships",
      "targetStatus": "implemented",
      "scope": "tenant/site",
      "operation": "upsert",
      "idempotencyKey": "membership:tenant-id:site-id:user-subject-or-source-id",
      "requiredFields": ["userId", "tenantId", "role", "status", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Tenant/site membership must be derived separately from identity profile import."
    },
    {
      "id": "navigation-items-seeded-from-site-template",
      "phase": 2,
      "sourceTables": [],
      "targetCollection": "navigationItems",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "seed",
      "idempotencyKey": "navigation-item:site-id:placement:href",
      "requiredFields": ["siteId", "placement", "label", "href", "order", "isVisible", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Starter templates create deterministic first navigation records."
    },
    {
      "id": "page-revisions-from-published-page-snapshots",
      "phase": 2,
      "sourceTables": ["contentItems"],
      "targetCollection": "pageRevisions",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "append",
      "idempotencyKey": "page-revision:site-id:route:revision-number",
      "requiredFields": ["pageId", "siteId", "title", "route", "blockSnapshot", "revisionNumber", "createdBy", "createdAt"],
      "externalWrites": false,
      "notes": "Initial revisions are generated from grouped content block snapshots."
    },
    {
      "id": "pages-from-content-items",
      "phase": 2,
      "sourceTables": ["contentItems", "leadMagnets", "programs"],
      "targetCollection": "pages",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "upsert",
      "idempotencyKey": "page:site-id:route",
      "requiredFields": ["siteId", "title", "route", "status", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Legacy site sections become routable pages before content block attachment."
    },
    {
      "id": "pipeline-stages-from-pipeline-stages",
      "phase": 3,
      "sourceTables": ["pipelineStages"],
      "targetCollection": "pipelineStages",
      "targetStatus": "implemented",
      "scope": "tenant/site",
      "operation": "upsert",
      "idempotencyKey": "pipeline-stage:source-table:pipelineStages:source-id",
      "requiredFields": ["tenantId", "name", "slug", "position", "isActive", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Legacy pipeline stage configuration becomes tenant defaults with optional site overrides."
    },
    {
      "id": "publish-events-from-initial-publication",
      "phase": 2,
      "sourceTables": [],
      "targetCollection": "publishEvents",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "append",
      "idempotencyKey": "publish-event:site-id:page-id:action:created-at",
      "requiredFields": ["siteId", "actorUserId", "action", "createdAt"],
      "externalWrites": false,
      "notes": "Initial publish events are generated by the import dry run and confirmed in hosted smoke before live use."
    },
    {
      "id": "roles-from-role-catalog",
      "phase": 1,
      "sourceTables": [],
      "targetCollection": "roles",
      "targetStatus": "implemented",
      "scope": "platform",
      "operation": "seed",
      "idempotencyKey": "role:key",
      "requiredFields": ["key", "label", "scope", "permissions", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Seeded by roleCatalog.syncDefaultRoles after platform admin bootstrap."
    },
    {
      "id": "sites-seeded-from-tenant-templates",
      "phase": 1,
      "sourceTables": [],
      "targetCollection": "sites",
      "targetStatus": "implemented",
      "scope": "tenant",
      "operation": "seed",
      "idempotencyKey": "site:tenant-id:slug",
      "requiredFields": ["tenantId", "name", "slug", "status", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "No legacy table cleanly represents multi-site tenancy, so first sites are created from templates."
    },
    {
      "id": "tasks-from-tasks",
      "phase": 3,
      "sourceTables": ["tasks"],
      "targetCollection": "tasks",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "upsert",
      "idempotencyKey": "task:source-table:tasks:source-id",
      "requiredFields": ["tenantId", "siteId", "createdBy", "title", "taskType", "priority", "status", "isAutomated", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Legacy follow-up tasks become site-scoped CRM tasks."
    },
    {
      "id": "tenant-entitlements-seeded-from-plan-overrides",
      "phase": 5,
      "sourceTables": [],
      "targetCollection": "tenantEntitlements",
      "targetStatus": "implemented",
      "scope": "tenant",
      "operation": "seed-after-approval",
      "idempotencyKey": "tenant-entitlement:tenant-id",
      "requiredFields": ["tenantId", "planKey", "source", "status", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Manual override entitlements are seeded before Stripe Billing owns subscription state."
    },
    {
      "id": "tenants-from-organizations",
      "phase": 1,
      "sourceTables": ["organizations"],
      "targetCollection": "tenants",
      "targetStatus": "implemented",
      "scope": "platform",
      "operation": "upsert",
      "idempotencyKey": "tenant:source-table:organizations:source-id",
      "requiredFields": ["name", "slug", "status", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Legacy organization records become KinFlo client accounts."
    },
    {
      "id": "theme-tokens-seeded-from-site-template",
      "phase": 1,
      "sourceTables": [],
      "targetCollection": "themeTokens",
      "targetStatus": "implemented",
      "scope": "site",
      "operation": "seed",
      "idempotencyKey": "theme-token:site-id",
      "requiredFields": ["siteId", "createdBy", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Starter template theme tokens become the first configurable site experience surface."
    },
    {
      "id": "users-from-users",
      "phase": 1,
      "sourceTables": ["users"],
      "targetCollection": "users",
      "targetStatus": "implemented",
      "scope": "user/platform",
      "operation": "upsert",
      "idempotencyKey": "user:auth-subject-or-source-id",
      "requiredFields": ["subject", "platformRole", "createdAt", "updatedAt"],
      "externalWrites": false,
      "notes": "Identity import must avoid raw session migration; sessions remain auth/provider-managed."
    }
  ]
}
