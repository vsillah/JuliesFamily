    "site": "A child workspace owns site configuration, content, brand, navigation, launch, and site operations.",
    "task": "An L3 task is one focused workflow with a source record, permission, blocker, next action, and audit event."
  },
  "lanes": [
    {
      "key": "control",
      "label": "Control",
