    },
    {
      "key": "launch",
      "label": "Launch",
      "routeTab": "launch-readiness",
      "purpose": "Readiness, preview, domains, handoff, and release gates.",
      "tasks": ["readiness", "preview", "domains", "handoff", "decide"]
    },
    {
      "key": "growth",
      "label": "Growth",
      "routeTab": "crm",
      "purpose": "CRM, communications, integrations, experimentation, and tenant operating signals.",
      "tasks": ["CRM", "communications", "campaigns", "integrations", "analytics"]
    },
    {
      "key": "evidence",
      "label": "Evidence & Activation",
      "routeTab": "hosted-activation",
      "purpose": "AI review, adapters, hosted activation, rollback evidence, and release ownership.",
      "tasks": ["AI review", "adapter readiness", "activation", "rollback evidence"]
    }
  ],
  "capabilities": [
    {
      "key": "crm_comms",
